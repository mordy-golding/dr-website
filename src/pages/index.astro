---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Design Responsibly"
  description="Helping brands pay creators quickly, compliantly, and respectfully. 20+ years of trusted experience and a boutique, human-first approach."
  path="/"
>
  <header class="site-header">
    <div class="section-inner header-inner">
      <a href="/" aria-label="Design Responsibly home">
        <img src="/assets/dr_logo.png" alt="Design Responsibly" class="header-logo" />
      </a>
    </div>
  </header>

  <main>

    <!-- ─── Hero ──────────────────────────────────────────── -->
    <section class="hero" aria-label="Introduction">
      <div class="section-inner">
        <div class="hero-text">
          <h1>Pay people<br>responsibly.</h1>
          <p class="hero-tagline">High-touch creator payment support for modern marketing teams.</p>
          <p class="hero-subhead">For over 20 years, we've helped organizations pay creators with clarity, compliance, and care.</p>
        </div>
      </div>
    </section>

    <!-- ─── Services ─────────────────────────────────────── -->
    <section class="services" aria-label="Services">
      <div class="section-inner">
        <h2 class="sr-only">Our Services</h2>
        <div class="services-grid">
          <article class="service-card">
            <h3>Payment administration</h3>
            <p>We collect, organize, and manage all incoming invoices on your behalf. Our team ensures every invoice is properly documented, compliant, and ready for quick processing.</p>
          </article>
          <article class="service-card">
            <h3>Domestic &amp; international payments</h3>
            <p>We deliver fast, reliable payments to creators and freelancers around the world. Every payment follows local regulations and your internal policies.</p>
          </article>
          <article class="service-card">
            <h3>Compliance and policy alignment</h3>
            <p>We ensure each payment meets legal, tax, and organizational requirements. Our team enforces your policies consistently so your program stays protected and audit-ready.</p>
          </article>
          <article class="service-card">
            <h3>1099 creation &amp; tax reporting</h3>
            <p>We manage year-end tax documentation for eligible freelancers to keep you in full compliance. Our team handles preparation, delivery, and data accuracy so you don't have to.</p>
          </article>
          <article class="service-card">
            <h3>Invoice intake &amp; management</h3>
            <p>We receive all creator invoices and verify that each one matches the agreed-upon scope and requirements. This keeps your operations clean, organized, and stress-free.</p>
          </article>
          <article class="service-card">
            <h3>Trusted support for both clients and creators</h3>
            <p>We offer responsive, human-first assistance for questions, needs, and edge cases. Our goal is to make the payment experience feel safe, smooth, and respectful for everyone involved.</p>
          </article>
          <article class="service-card service-card--featured">
            <h3>Advisory guidance for complex or high-volume programs</h3>
            <p>We help you navigate special circumstances, compliance questions, and program structure. Our team acts as your partner to ensure your creator initiatives run effectively at scale.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ─── Value Props ───────────────────────────────────── -->
    <section class="value-props" aria-label="Who we serve">
      <div class="section-inner">
        <h2 class="sr-only">Who We Serve</h2>
        <div class="vp-grid">
          <div class="vp-col">
            <h3 class="vp-heading">For Brands &amp; Marketing Teams</h3>
            <ul class="vp-list">
              <li>
                <span class="check-wrap" aria-hidden="true"><img src="/assets/checked.svg" alt="" width="11" height="11" /></span>
                Simplify creator payments with one partner and one clean process
              </li>
              <li>
                <span class="check-wrap" aria-hidden="true"><img src="/assets/checked.svg" alt="" width="11" height="11" /></span>
                Avoid long vendor onboarding and procurement delays
              </li>
              <li>
                <span class="check-wrap" aria-hidden="true"><img src="/assets/checked.svg" alt="" width="11" height="11" /></span>
                Ensure payments are compliant, consistent, and audit-ready
              </li>
              <li>
                <span class="check-wrap" aria-hidden="true"><img src="/assets/checked.svg" alt="" width="11" height="11" /></span>
                Protect creator relationships through fast, respectful payments
              </li>
              <li>
                <span class="check-wrap" aria-hidden="true"><img src="/assets/checked.svg" alt="" width="11" height="11" /></span>
                Reduce administrative burden on your team
              </li>
            </ul>
          </div>
          <div class="vp-col">
            <h3 class="vp-heading">For Creators &amp; Freelancers</h3>
            <ul class="vp-list">
              <li>
                <span class="check-wrap" aria-hidden="true"><img src="/assets/checked.svg" alt="" width="11" height="11" /></span>
                Fast, reliable payment delivery
              </li>
              <li>
                <span class="check-wrap" aria-hidden="true"><img src="/assets/checked.svg" alt="" width="11" height="11" /></span>
                Clear communication and human support
              </li>
              <li>
                <span class="check-wrap" aria-hidden="true"><img src="/assets/checked.svg" alt="" width="11" height="11" /></span>
                A payment process that feels safe, simple, and trustworthy
              </li>
              <li>
                <span class="check-wrap" aria-hidden="true"><img src="/assets/checked.svg" alt="" width="11" height="11" /></span>
                Respect for your time, your work, and your livelihood
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Stats ─────────────────────────────────────────── -->
    <section class="stats" aria-label="By the numbers">
      <div class="section-inner">
        <h2 class="sr-only">By the Numbers</h2>
        <div class="stats-row">
          <div class="stat">
            <span class="stat-num">22k</span>
            <span class="stat-label">Payments processed<br>and delivered</span>
          </div>
          <div class="stat">
            <span class="stat-num">$45M</span>
            <span class="stat-label">Paid to creators<br>and freelancers</span>
          </div>
          <div class="stat">
            <span class="stat-num">5.2k</span>
            <span class="stat-label">Freelancers and<br>creators served</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── About ─────────────────────────────────────────── -->
    <section class="about" aria-label="About us">
      <div class="section-inner">
        <h2 class="sr-only">About Design Responsibly</h2>
        <p class="about-text">Since 2004, we've partnered with organizations that work with large numbers of creators and freelancers — helping them pay people quickly, compliantly, and with genuine human care. We specialize in supporting influencer and creator programs where traditional procurement and onboarding processes simply can't keep up. Our approach blends decades of operational expertise with warm, personalized support for every creator we serve.</p>
      </div>
    </section>

    <!-- ─── Values ────────────────────────────────────────── -->
    <section class="values" aria-label="Our values">
      <div class="section-inner">
        <h2 class="sr-only">Our Values</h2>
        <div class="values-grid">
          <div class="value-item">
            <span class="value-pip" aria-hidden="true"></span>
            <h3>Responsibility</h3>
            <p>We do what's right, not just what's easy.</p>
          </div>
          <div class="value-item">
            <span class="value-pip" aria-hidden="true"></span>
            <h3>Trust</h3>
            <p>We protect sensitive data, finances, and relationships.</p>
          </div>
          <div class="value-item">
            <span class="value-pip" aria-hidden="true"></span>
            <h3>Care</h3>
            <p>Creators are people, not line items.</p>
          </div>
          <div class="value-item">
            <span class="value-pip" aria-hidden="true"></span>
            <h3>Compliance</h3>
            <p>Every payment follows legal and policy standards.</p>
          </div>
          <div class="value-item">
            <span class="value-pip" aria-hidden="true"></span>
            <h3>Partnership</h3>
            <p>We act as advisors, not vendors.</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- ─── Footer ────────────────────────────────────────── -->
  <footer class="footer">
    <div class="section-inner footer-inner">
      <div class="footer-brand">
        <a href="/" aria-label="Design Responsibly home">
          <img src="/assets/dr_logo.png" alt="Design Responsibly" class="footer-logo" />
        </a>
        <p class="footer-tagline">Trusted creator payment partner<br>for brands that value relationships.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a
          href="https://www.linkedin.com/company/designresponsibly/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Design Responsibly on LinkedIn"
        >
          <img src="/assets/si-linkedin.svg" alt="LinkedIn" width="18" height="18" class="linkedin-icon" />
        </a>
        <a href="/legal" class="footer-text-link">Legal</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .hero {
    background: #ffffff;
    min-height: 92svh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: 88px 0 100px;
  }

  /* Colorful gradient mesh — top-right decoration, Stripe-style */
  .hero::before {
    content: '';
    position: absolute;
    top: -160px;
    right: -160px;
    width: 860px;
    height: 860px;
    background:
      radial-gradient(ellipse at 25% 45%, rgba(14, 165, 233, 0.55) 0%, transparent 50%),
      radial-gradient(ellipse at 72% 22%, rgba(99, 102, 241, 0.45) 0%, transparent 50%),
      radial-gradient(ellipse at 55% 78%, rgba(6, 182, 212, 0.4) 0%, transparent 50%);
    filter: blur(72px);
    pointer-events: none;
    z-index: 0;
  }

  .hero .section-inner {
    position: relative;
    z-index: 1;
  }

  .hero-text {
    max-width: 640px;
  }

  .hero h1 {
    font-size: clamp(44px, 6.5vw, 80px);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.035em;
    color: #0F172A;
    margin-bottom: 28px;
  }

  .hero-tagline {
    font-size: clamp(16px, 1.8vw, 20px);
    font-weight: 400;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 12px;
    max-width: 480px;
  }

  .hero-subhead {
    font-size: 15px;
    color: #94A3B8;
    line-height: 1.7;
    max-width: 440px;
  }

  /* ── Services ───────────────────────────────────────────── */
  .services {
    background: #F8FAFC;
    padding: clamp(72px, 10vw, 120px) 0;
    border-top: 1px solid rgba(15, 23, 42, 0.07);
    border-bottom: 1px solid rgba(15, 23, 42, 0.07);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .service-card {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 14px;
    padding: 32px 28px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .service-card:hover {
    border-color: rgba(14, 165, 233, 0.35);
    box-shadow: 0 4px 24px rgba(14, 165, 233, 0.07);
  }

  .service-card h3 {
    font-size: 15px;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 10px;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .service-card p {
    font-size: 14px;
    color: #64748B;
    line-height: 1.7;
  }

  .service-card--featured {
    grid-column: 1 / -1;
    background: rgba(14, 165, 233, 0.04);
    border-color: rgba(14, 165, 233, 0.18);
  }

  .service-card--featured:hover {
    border-color: rgba(14, 165, 233, 0.45);
    box-shadow: 0 4px 24px rgba(14, 165, 233, 0.08);
  }

  /* ── Value Props ─────────────────────────────────────────── */
  .value-props {
    background: #ffffff;
    padding: clamp(72px, 10vw, 120px) 0;
    border-bottom: 1px solid rgba(15, 23, 42, 0.07);
  }

  .vp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 88px;
  }

  .vp-heading {
    font-size: clamp(22px, 2.8vw, 32px);
    font-weight: 700;
    color: #0F172A;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  .vp-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .vp-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(15, 23, 42, 0.07);
    font-size: 15px;
    color: #334155;
    line-height: 1.55;
    min-height: 44px;
  }

  .vp-list li:first-child {
    border-top: 1px solid rgba(15, 23, 42, 0.07);
  }

  .check-wrap {
    width: 22px;
    height: 22px;
    min-width: 22px;
    background: rgba(14, 165, 233, 0.1);
    border: 1px solid rgba(14, 165, 233, 0.22);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* ── Stats — the one dark section ──────────────────────── */
  .stats {
    background: #0A0F1E;
    padding: clamp(80px, 11vw, 128px) 0;
  }

  .stats-row {
    display: flex;
  }

  .stat {
    flex: 1;
    text-align: center;
    padding: 0 40px;
  }

  .stat + .stat {
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stat-num {
    display: block;
    font-size: clamp(60px, 10vw, 104px);
    font-weight: 800;
    color: #ffffff;
    line-height: 0.95;
    letter-spacing: -0.05em;
    margin-bottom: 16px;
  }

  .stat-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #64748B;
    line-height: 1.6;
  }

  /* ── About ──────────────────────────────────────────────── */
  .about {
    background: #F8FAFC;
    padding: clamp(72px, 10vw, 120px) 0;
    border-top: 1px solid rgba(15, 23, 42, 0.07);
    border-bottom: 1px solid rgba(15, 23, 42, 0.07);
  }

  .about-text {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 400;
    color: #334155;
    line-height: 1.8;
  }

  /* ── Values ─────────────────────────────────────────────── */
  .values {
    background: #ffffff;
    padding: clamp(72px, 10vw, 120px) 0;
    border-bottom: 1px solid rgba(15, 23, 42, 0.07);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  .value-item {
    background: #F8FAFC;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 14px;
    padding: 32px 24px;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .value-item:hover {
    border-color: rgba(14, 165, 233, 0.35);
    background: rgba(14, 165, 233, 0.04);
  }

  .value-pip {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0EA5E9;
    margin-bottom: 18px;
  }

  .value-item h3 {
    font-size: 15px;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .value-item p {
    font-size: 13px;
    color: #64748B;
    line-height: 1.65;
  }

  /* ── Site Header ────────────────────────────────────────── */
  .site-header {
    background: #ffffff;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }

  .header-inner {
    height: 64px;
    display: flex;
    align-items: center;
  }

  .header-logo {
    height: 28px;
    width: auto;
  }

  /* ── Footer ─────────────────────────────────────────────── */
  .footer {
    background: #ffffff;
    border-top: 2px solid #0A0F1E;
    padding: 56px 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 40px;
  }

  .footer-logo {
    height: 26px;
    width: auto;
    margin-bottom: 16px;
  }

  .footer-tagline {
    font-size: 13px;
    color: #64748B;
    line-height: 1.65;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-top: 2px;
  }

  .footer-nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: #64748B;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: #0F172A;
  }

  .linkedin-icon {
    transition: opacity 0.2s;
  }

  .footer-nav a:hover .linkedin-icon {
    opacity: 0.8;
  }

  .footer-text-link {
    font-size: 13px;
    font-weight: 500;
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-card--featured {
      grid-column: auto;
    }

    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      padding: 80px 0 72px;
    }

    .hero-text {
      max-width: 100%;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .vp-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }

    .stats-row {
      flex-direction: column;
    }

    .stat {
      padding: 36px 0;
      text-align: left;
    }

    .stat + .stat {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .values-grid {
      grid-template-columns: 1fr;
    }

    .footer-inner {
      flex-direction: column;
      gap: 28px;
    }
  }
</style>
