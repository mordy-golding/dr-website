---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import AccountCard from '../components/AccountCard.astro';
import ContactForm from '../components/ContactForm.astro';

const steps = [
  { n: '01', title: 'Approve us once.', body: 'Your procurement team sets up Design Responsibly as a single vendor, with one statement of work and one purchase order.' },
  { n: '02', title: 'Fund your program.', body: 'Your PO funds a dedicated account for your program, so payees aren’t waiting on your company’s payment terms.' },
  { n: '03', title: 'Approve the work.', body: 'Your team approves invoices the way it already works: by email, or in bulk through a shared folder.' },
  { n: '04', title: 'We handle the rest.', body: 'We onboard each payee, collect their tax documentation, pay them, and answer their questions.' },
];

const stats = [
  { figure: '33,900+', label: 'payments delivered' },
  { figure: '$68M+', label: 'paid out' },
  { figure: '6,500+', label: 'people and organizations paid' },
  { figure: '60+', label: 'countries' },
];

const programs = [
  { title: 'Creator and influencer programs', body: 'Campaigns, ambassador networks, and sponsored content.' },
  { title: 'Community and partner programs', body: 'Professional associations, user groups, and local organizations.' },
  { title: 'Speakers and events', body: 'Presenters, hosts, livestream talent, and event partners.' },
  { title: 'Education programs', body: 'Instructors, schools, and training partners.' },
];

const goodFit = [
  'makes hundreds of payments a quarter',
  'pays many people small amounts',
  'pays people outside the U.S.',
  'can’t wait for each payee to clear vendor onboarding',
];

// Icon paths are from Main.dc.html (24×24, stroked).
const handles = [
  { title: 'Payee onboarding', body: 'We collect each payee’s details, banking information, and tax forms (W-9 or W-8BEN) directly from them. Your team never handles it.', icon: '<circle cx="9" cy="8" r="4"></circle><path d="M2 21c0-4 3-7 7-7s7 3 7 7"></path><path d="M19 8v6M16 11h6"></path>' },
  { title: 'Domestic and international payments', body: 'ACH in the U.S. and wire transfers worldwide. Typically within 7–14 days of an approved invoice, and as fast as the next day.', icon: '<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"></path>' },
  { title: 'Invoice intake', body: 'We log every approved invoice, match it to an onboarded payee, and confirm funds are available before paying.', icon: '<path d="M3 13l3-8h12l3 8v6H3z"></path><path d="M3 13h5l1 3h6l1-3h5"></path>' },
  { title: 'Year-end 1099s', body: 'We prepare and deliver 1099s for eligible U.S. payees. Your team has nothing to file for them.', icon: '<path d="M6 3h9l4 4v14H6z"></path><path d="M14 3v5h5M9 13h7M9 17h7"></path>' },
  { title: 'Budget visibility', body: 'A live view of your PO balances and every payment made under them.', icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path>' },
  { title: 'Payee support', body: 'Every payee can reach a real person with questions about their payment.', icon: '<path d="M4 5h16v11H9l-5 4z"></path>' },
  { title: 'Program advice', body: 'Planning a new program, or paying someone unusual? We’ll help you structure it before the first payment goes out.', icon: '<circle cx="12" cy="12" r="9"></circle><path d="M15.5 8.5l-2 5-5 2 2-5z"></path>' },
];

const payeePoints = [
  { title: 'One-time setup.', body: 'You share your details once, using the link your client sends you, and we keep them on file for future work.' },
  { title: 'Fast payment.', body: 'Typically within 7–14 days after your invoice is approved.' },
  { title: 'Confirmation.', body: 'You get an email when your payment is sent.' },
  { title: 'A real person.', body: 'Questions about a payment come to us, not a ticket queue.' },
];

// Answers are HTML so the privacy answer can link to the policy.
const faqs = [
  { q: 'Is Design Responsibly a software platform?', a: 'No. We’re a payment administrator. We do the work instead of giving your team a tool to run.' },
  { q: 'Do our payees become our vendors?', a: 'No. Your company approves one vendor: us. Payees onboard with Design Responsibly.' },
  { q: 'How fast are payees paid?', a: 'Typically within 7–14 days of an approved invoice, and as fast as the next day.' },
  { q: 'What does it cost?', a: 'Pricing depends on your program: how many payments you make and where your payees are. You’re paying for a service, not licensing software. Tell us about your program and we’ll give you a quote.' },
  { q: 'What happens when our PO runs low?', a: 'We only pay from funds on deposit for your program. You can watch your balance live, and you open a new PO when you need more.' },
  { q: 'Can you pay people outside the U.S.?', a: 'Yes. We pay people in 60+ countries, by ACH or wire depending on the payee’s bank.' },
  { q: 'How do you handle taxes?', a: 'We collect the right tax form from each payee and issue year-end 1099s for eligible U.S. payees.' },
  { q: 'How is payee data protected?', a: 'Payees submit their banking and tax information directly to us, so it never passes through your team. Access is limited to the people who process payments. During setup, we work through your company’s vendor and security review and can walk your team through how we handle payee data. See our <a href="/legal/privacy-policy">Privacy Policy</a> for details.', open: true },
];

const values = [
  { title: 'Responsibility', body: 'We do what’s right, not what’s easy.' },
  { title: 'Trust', body: 'We protect sensitive data, budgets, and relationships.' },
  { title: 'Care', body: 'Payees are people, not line items.' },
  { title: 'Precision', body: 'Every payment documented, matched, and accounted for.' },
  { title: 'Partnership', body: 'We advise. We don’t just process.' },
];
---
<BaseLayout
  title="Design Responsibly — Pay people responsibly"
  description="One approved vendor for the hundreds of creators, speakers, and community partners your program pays. Paid in days, in 60+ countries."
  path="/"
>
  <SiteHeader slot="header" homeHref="#top">
    <a href="#how">How it works</a>
    <a href="#who">Who we serve</a>
    <a href="#payees">For payees</a>
    <a href="#faq">FAQ</a>
    <a href="#contact" class="btn btn-primary nav-cta">Talk to us</a>
  </SiteHeader>

  <!-- HERO -->
  <section id="top" class="container hero">
    <div class="hero-text">
      <p class="eyebrow hero-eyebrow">Payment administration for large programs</p>
      <h1 class="hero-title">Pay people <em>responsibly.</em></h1>
      <p class="hero-lede">One vendor for the hundreds of creators, speakers, and community partners your program pays.</p>
      <p class="hero-sub muted">Your procurement team approves us once. We onboard, pay, and support every payee, typically within 7–14 days, in 60+ countries.</p>
      <div class="hero-ctas">
        <a href="#contact" class="btn btn-primary cta-lg">Talk to us</a>
        <a href="#how" class="btn btn-outline cta-lg cta-outline">See how it works</a>
      </div>
    </div>
    <div class="hero-visual">
      <AccountCard />
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="band-alt" aria-labelledby="problem-title">
    <div class="container section split">
      <div class="half">
        <p class="eyebrow">The problem</p>
        <h2 id="problem-title" class="display">Your program moves faster than <em>procurement.</em></h2>
        <p class="lead-first">Programs that build awareness and adoption pay a lot of people: creators, speakers, educators, community groups, and small agencies. Most of the payments are small, and many cross borders.</p>
        <p class="lead-next">Getting each payee through vendor onboarding takes weeks. Standard payment terms add months. Your team ends up chasing paperwork, and the people you depend on wait to get paid.</p>
      </div>
      <div class="half card timeline">
        <p class="timeline-title">Time until a payee gets paid</p>
        <p class="timeline-label">Each payee as your vendor</p>
        <div class="timeline-bar">
          <div class="seg seg-onboard">Onboarding: weeks</div>
          <div class="seg seg-terms">Payment terms: months</div>
        </div>
        <p class="timeline-label timeline-label-2">Through Design Responsibly</p>
        <div class="timeline-bar">
          <div class="seg seg-dr">7–14 days</div>
        </div>
        <p class="timeline-note muted">Typical, from an approved invoice. As fast as the next day.</p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" class="container section-lg" aria-labelledby="how-title">
    <p class="eyebrow">How it works</p>
    <h2 id="how-title" class="display narrow">One vendor. Hundreds of payees. <em>Paid in days.</em></h2>

    <div class="flow">
      <div class="flow-box flow-you">
        <p class="flow-label">Your company</p>
        <p class="flow-text">1 vendor · 1 SOW · 1 PO</p>
      </div>
      <div class="flow-arrow" aria-hidden="true"><svg width="36" height="24" viewBox="0 0 36 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h30M24 4l8 8-8 8"></path></svg></div>
      <div class="flow-box flow-dr">
        <p class="flow-label">Design Responsibly</p>
        <p class="flow-text">Onboard · pay · support</p>
      </div>
      <div class="flow-arrow" aria-hidden="true"><svg width="36" height="24" viewBox="0 0 36 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h30M24 4l8 8-8 8"></path></svg></div>
      <div class="flow-box flow-payees">
        <p class="flow-label">Your payees</p>
        <p class="flow-text">Hundreds, in 60+ countries</p>
      </div>
    </div>

    <ol class="steps">
      {steps.map((s) => (
        <li class="step">
          <p class="step-n" aria-hidden="true">{s.n}</p>
          <h3>{s.title}</h3>
          <p class="muted">{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="how-foot">Your team sees its balance and every payment, live, at any time.</p>
  </section>

  <!-- NUMBERS -->
  <section class="band-dark on-dark" aria-labelledby="numbers-title">
    <div class="container numbers">
      <h2 id="numbers-title" class="eyebrow numbers-eyebrow">By the numbers</h2>
      <div class="stats">
        {stats.map((s) => (
          <div class="stat">
            <p class="stat-figure">{s.figure}</p>
            <p class="stat-label">{s.label}</p>
          </div>
        ))}
      </div>
      <p class="numbers-quote">Trusted by multiple teams inside a Fortune 500 technology company. <em>Most found us through each other.</em></p>
    </div>
  </section>

  <!-- WHO -->
  <section id="who" class="container section-lg" aria-labelledby="who-title">
    <p class="eyebrow">Who we work with</p>
    <h2 id="who-title" class="display narrow">Built for programs that pay <em>the long tail.</em></h2>
    <div class="programs">
      {programs.map((p) => (
        <div class="card program">
          <h3>{p.title}</h3>
          <p class="muted">{p.body}</p>
        </div>
      ))}
    </div>

    <div class="who-more">
      <div class="who-pay">
        <h3>Who we pay</h3>
        <p class="muted">Individuals, one-person studios, agencies, nonprofits, schools, and festivals, in the U.S. and around the world.</p>
      </div>
      <div class="fit">
        <h3>A good fit if your program:</h3>
        <ul>
          {goodFit.map((item) => (
            <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- WHAT WE HANDLE -->
  <section class="band-alt" aria-labelledby="handle-title">
    <div class="container section-lg">
      <p class="eyebrow">What we handle</p>
      <h2 id="handle-title" class="display">The admin <em>leaves your team.</em></h2>
      <div class="handles">
        {handles.map((h) => (
          <div class="handle">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={h.icon}></svg>
            <div>
              <h3>{h.title}</h3>
              <p class="muted">{h.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PAYEES -->
  <section id="payees" class="container section-lg" aria-labelledby="payees-title">
    <div class="payees">
      <div class="payees-intro">
        <p class="payees-tag">For creators and payees</p>
        <h2 id="payees-title" class="display display-sm">Getting paid by us</h2>
        <p class="muted payees-lede">If a client has told you you’ll be paid through Design Responsibly, here’s what to expect:</p>
      </div>
      <div class="payees-points">
        {payeePoints.map((p) => (
          <div>
            <h3>{p.title}</h3>
            <p class="muted">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="faq-band" aria-labelledby="faq-title">
    <div class="container section-lg faq">
      <div class="faq-intro">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title" class="display display-sm">Questions from <em>procurement and finance.</em></h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details open={f.open}>
            <summary>{f.q}<span class="plus" aria-hidden="true">+</span></summary>
            <p class="muted" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT + VALUES -->
  <section id="about" class="band-alt about-band" aria-labelledby="about-title">
    <div class="container section-lg">
      <div class="about">
        <div class="about-intro">
          <p class="eyebrow">About</p>
          <h2 id="about-title" class="display about-title">Small <em>on purpose.</em></h2>
          <p class="about-since muted">Paying people on clients’ behalf since 2004</p>
        </div>
        <div class="about-body">
          <p>Design Responsibly has paid people on its clients’ behalf since 2004. Over the last decade, that work grew into high-volume programs that pay thousands of people a year in dozens of countries.</p>
          <p>We’ve stayed boutique by choice. We work with a small number of programs, so every client gets direct access to the people doing the work, and every payee gets someone who answers.</p>
        </div>
      </div>
      <div class="values">
        {values.map((v) => (
          <div class="card value">
            <h3>{v.title}</h3>
            <p class="muted">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="band-dark on-dark" aria-labelledby="contact-title">
    <div class="container contact">
      <div class="contact-intro">
        <h2 id="contact-title" class="display contact-title">Running a program that pays <em>the long tail?</em></h2>
        <p class="contact-lede">Tell us how many people you pay and where. We’ll tell you honestly whether we’re the right fit.</p>
        <p class="reply-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>A real person replies within one business day.
        </p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  section[id] { scroll-margin-top: 16px; }

  .nav-cta {
    padding: 11px 20px;
  }

  .section { padding-top: 104px; padding-bottom: 104px; }
  .section-lg { padding-top: 112px; padding-bottom: 112px; }

  .narrow { max-width: 820px; }

  .display-sm {
    font-size: clamp(34px, 3.6vw, 48px);
    line-height: 1.1;
  }

  /* Hero */
  .hero {
    padding-top: 96px;
    padding-bottom: 104px;
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: center;
  }

  .hero-text { flex: 1 1 480px; min-width: 0; }
  .hero-eyebrow { margin-bottom: 20px; }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(48px, 6.4vw, 92px);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .hero-title em { color: var(--accent); }

  .hero-lede { margin-top: 28px; font-size: 22px; line-height: 1.45; max-width: 540px; }
  .hero-sub { margin-top: 16px; max-width: 520px; }

  .hero-ctas {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .cta-lg { padding: 15px 28px; font-size: 16px; }
  .cta-outline { padding: 13px 26px; }

  .hero-visual { flex: 1 1 420px; min-width: 0; max-width: 520px; }

  /* Problem */
  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: flex-start;
  }

  .half { flex: 1 1 440px; min-width: 0; }
  .lead-first { margin-top: 28px; }
  .lead-next { margin-top: 16px; }

  .timeline { border-radius: 20px; padding: 32px; }
  .timeline-title { margin-bottom: 24px; font-weight: 700; }
  .timeline-label { margin-bottom: 8px; font-size: 14px; font-weight: 600; }
  .timeline-label-2 { margin-top: 28px; }

  .timeline-bar { display: flex; gap: 4px; height: 52px; }

  .seg {
    display: flex;
    align-items: center;
    padding: 0 12px;
    font-size: 13px;
    font-weight: 600;
  }

  .seg-onboard {
    flex: 2 1 0;
    background: var(--rule);
    border-radius: 8px 0 0 8px;
    color: var(--ink);
  }

  .seg-terms {
    flex: 3 1 0;
    background: repeating-linear-gradient(135deg, #8C8170 0 8px, #9A8F7D 8px 16px);
    border-radius: 0 8px 8px 0;
    color: var(--card);
  }

  .seg-dr {
    width: 22%;
    min-width: 120px;
    background: var(--forest);
    border-radius: 8px;
    font-weight: 700;
    color: var(--on-dark);
  }

  .timeline-note { margin-top: 24px; font-size: 13px; }

  /* How it works */
  .flow {
    margin-top: 56px;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 12px;
  }

  .flow-box {
    flex: 1 1 240px;
    border-radius: 16px;
    padding: 24px;
  }

  .flow-you { border: 2px solid var(--ink); background: var(--card); }
  .flow-dr { background: var(--forest); color: var(--on-dark); }
  .flow-payees { border: 2px dashed var(--ink); background: var(--card); }

  .flow-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .flow-dr .flow-label { color: var(--gold); }

  .flow-text {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.25;
  }

  .flow-arrow {
    flex: 0 0 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
  }

  .steps {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }

  .step { border-top: 3px solid var(--ink); padding-top: 20px; }

  .step-n {
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1;
    color: var(--accent);
  }

  .step h3 { margin: 14px 0 8px; font-size: 19px; }

  .how-foot { margin-top: 40px; font-weight: 600; }

  /* Numbers */
  .numbers { padding-top: 96px; padding-bottom: 96px; }
  .numbers-eyebrow { margin-bottom: 40px; color: var(--gold); }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
  }

  .stat { border-left: 2px solid var(--gold); padding-left: 20px; }

  .stat-figure {
    font-family: var(--font-display);
    font-size: clamp(48px, 5vw, 68px);
    line-height: 1;
  }

  .stat-label { margin-top: 10px; font-size: 16px; color: var(--on-dark-muted); }

  .numbers-quote {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid #4A5E50;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.4;
    max-width: 760px;
  }

  .numbers-quote em { color: var(--gold); }

  /* Who */
  .programs {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .program { padding: 28px; }
  .program h3 { margin-bottom: 10px; font-size: 19px; }

  .who-more {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }

  .who-pay { flex: 1 1 420px; min-width: 0; }
  .who-pay h3 { margin-bottom: 12px; font-size: 19px; }

  .fit {
    flex: 1 1 420px;
    min-width: 0;
    border: 2px solid var(--ink);
    border-radius: 16px;
    padding: 28px;
  }

  .fit h3 { margin-bottom: 16px; font-size: 19px; }

  .fit ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fit li { display: flex; gap: 12px; align-items: flex-start; }
  .fit svg { flex: none; margin-top: 2px; color: var(--forest); }

  /* What we handle */
  .handles {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 40px 48px;
  }

  .handle { display: flex; gap: 18px; }
  .handle svg { flex: none; color: var(--forest); }
  .handle h3 { margin-bottom: 6px; font-size: 18px; }

  /* Payees */
  .payees {
    border: 2px solid var(--ink);
    border-radius: 24px;
    padding: clamp(28px, 5vw, 64px);
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    background: var(--card);
  }

  .payees-intro { flex: 1 1 340px; min-width: 0; }

  .payees-tag {
    margin-bottom: 16px;
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-accent);
    background: var(--forest);
    padding: 6px 12px;
    border-radius: 6px;
  }

  .payees-lede { margin-top: 20px; }

  .payees-points {
    flex: 2 1 480px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
  }

  .payees-points h3 { margin-bottom: 6px; font-size: 18px; }

  /* FAQ */
  .faq-band { border-top: 1px solid var(--border); }

  .faq {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
  }

  .faq-intro { flex: 1 1 320px; min-width: 0; }

  .faq-list {
