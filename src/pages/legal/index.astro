---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { formatDate } from '../../lib/format-date';

const docs = (await getCollection('legal')).map((doc) => ({
  slug: doc.id.replace(/\.mdx?$/, ''),
  ...doc.data,
}));
---
<BaseLayout
  title="Legal & Policies | Design Responsibly"
  description="Design Responsibly's legal policies, terms, and compliance documents."
  path="/legal/"
>
  <SiteHeader slot="header">
    <a href="/" class="back">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>Back to home</a>
  </SiteHeader>

  <div class="container page">
    <p class="eyebrow">Legal</p>
    <h1>Legal &amp; <em>Policies</em></h1>
    <p class="sub muted">Our policies, terms, and compliance documents.</p>

    <ul class="docs">
      {docs.map((d) => (
        <li>
          <a href={`/legal/${d.slug}`} class="doc">
            <div class="doc-main">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg>
              <div>
                <h2>{d.title}</h2>
                {(d.summary ?? d.description) && <p class="muted">{d.summary ?? d.description}</p>}
                <p class="muted date">Last updated {formatDate(d.last_updated)}</p>
              </div>
            </div>
            <span class="read">Read policy<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="questions muted">Questions about these policies? <a href="/#contact">Contact us</a>.</p>
  </div>
</BaseLayout>

<style>
  .back { font-weight: 600; }

  .page {
    padding-top: 96px;
    padding-bottom: 120px;
    min-height: 60vh;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 5vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  h1 em { color: var(--accent); }

  .sub { margin-top: 20px; font-size: 20px; max-width: 560px; }

  .docs {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    border-top: 2px solid var(--ink);
    max-width: 880px;
  }

  .doc {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 4px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }

  .doc-main {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    flex: 1 1 420px;
    min-width: 0;
  }

  .doc-main svg { flex: none; margin-top: 4px; color: var(--forest); }

  h2 {
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.2;
  }

  .date { margin-top: 8px; font-size: 14px; font-weight: 600; }

  .read {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--accent);
  }

  .doc:hover h2 { color: var(--accent); }
  .doc:hover .read svg { transform: translateX(3px); }
  .read svg { transition: transform 0.2s; }

  .questions { margin-top: 32px; font-size: 15px; max-width: 640px; }
</style>
