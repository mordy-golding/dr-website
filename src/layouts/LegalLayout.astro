---
interface Props {
  title: string;
  lastUpdated?: string;
  description?: string;
  slug?: string;
}

const { title, lastUpdated, description, slug } = Astro.props;
const fullTitle = `${title} | Design Responsibly`;
const canonicalURL = slug
  ? `https://www.designresponsibly.com/legal/${slug}`
  : 'https://www.designresponsibly.com/legal/';
const ogImage = 'https://www.designresponsibly.com/assets/og-image.png';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/favicon.ico" />

  <meta property="og:title" content={fullTitle} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <header class="legal-header">
    <div class="header-inner">
      <a href="/" aria-label="Design Responsibly home">
        <img src="/assets/dr_logo.png" alt="Design Responsibly" width="140" class="header-logo" />
      </a>
      <a href="/legal" class="back-link">← Back to Legal</a>
    </div>
  </header>

  <main class="legal-main">
    <article class="legal-content">
      <h1>{title}</h1>
      {lastUpdated && <p class="last-updated">Last updated: {lastUpdated}</p>}
      <div class="legal-body">
        <slot />
      </div>
    </article>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <a href="/" aria-label="Design Responsibly home">
        <img src="/assets/dr_logo.png" alt="Design Responsibly" width="120" class="footer-logo" />
      </a>
      <p class="footer-tagline">Trusted creator payment partner for brands that value relationships.</p>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/legal">Legal</a>
        <a
          href="https://www.linkedin.com/company/designresponsibly/"
          target="_blank"
          rel="noopener noreferrer"
        >LinkedIn</a>
      </nav>
    </div>
  </footer>
</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: #F5F7FA;
    color: #0F172A;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a { color: inherit; }

  .legal-header {
    background: #ffffff;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    padding: 0 40px;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-logo {
    height: 28px;
    width: auto;
  }

  .back-link {
    font-size: 14px;
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.2s;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .back-link:hover { color: #0F172A; }

  .legal-main {
    padding: 64px 40px 100px;
  }

  .legal-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .legal-content h1 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    color: #0F172A;
    line-height: 1.2;
    margin-bottom: 6px;
  }

  .last-updated {
    font-size: 13px;
    color: #94A3B8;
    margin-bottom: 48px;
  }

  .legal-body {
    font-size: 16px;
    line-height: 1.8;
    color: #0F172A;
  }

  .legal-body h2 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #0F172A;
    margin: 40px 0 14px;
  }

  .legal-body h3 {
    font-size: 16px;
    font-weight: 600;
    color: #0F172A;
    margin: 28px 0 10px;
  }

  .legal-body p { margin-bottom: 18px; }

  .legal-body ul,
  .legal-body ol {
    padding-left: 24px;
    margin-bottom: 18px;
  }

  .legal-body li { margin-bottom: 8px; }

  .legal-body a {
    color: #0EA5E9;
    text-decoration: underline;
  }

  .legal-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin-bottom: 24px;
  }

  .legal-body th {
    text-align: left;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #94A3B8;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
  }

  .legal-body td {
    padding: 12px 14px;
    color: #334155;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    vertical-align: top;
    line-height: 1.6;
  }

  .legal-body tr:last-child td {
    border-bottom: none;
  }

  .legal-body hr {
    border: none;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    margin: 40px 0;
  }

  .site-footer {
    background: #ffffff;
    border-top: 2px solid #0A0F1E;
    padding: 48px 40px;
  }

  .footer-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-logo {
    height: 26px;
    width: auto;
  }

  .footer-tagline {
    font-size: 13px;
    color: #64748B;
    line-height: 1.5;
  }

  .footer-nav {
    display: flex;
    gap: 20px;
    padding-top: 4px;
  }

  .footer-nav a {
    font-size: 13px;
    color: #64748B;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-nav a:hover { color: #0F172A; }

  @media (max-width: 767px) {
    .legal-header { padding: 0 24px; }
    .legal-main { padding: 48px 24px 72px; }
    .site-footer { padding: 48px 24px; }
  }
</style>
